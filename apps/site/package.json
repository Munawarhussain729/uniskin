{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-css.mjs && vite build",
    "pretest": "pnpm --filter uniskin build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@uniskin/daisyui": "workspace:*",
    "@uniskin/shadcn": "workspace:*",
    "uniskin": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "~22.20.5",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
