{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-css.mjs && vite build",
    "pretest": "pnpm --filter uniskin --filter @uniskin/shadcn --filter @uniskin/daisyui --filter @uniskin/bootstrap --filter @uniskin/flowbite --filter @uniskin/radix build",
    "test": "vitest run && pnpm run test:a11y",
    "test:a11y": "playwright install chromium --only-shell || playwright install chromium; playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@uniskin/bootstrap": "workspace:*",
    "@uniskin/daisyui": "workspace:*",
    "@uniskin/flowbite": "workspace:*",
    "@uniskin/radix": "workspace:*",
    "@uniskin/shadcn": "workspace:*",
    "uniskin": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "~22.20.5",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
