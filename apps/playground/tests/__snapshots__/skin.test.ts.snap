// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compiled skins > daisyui > .ui-button base rule matches snapshot 1`] = `
".ui-button {
    --ui-c: var(--ui-neutral);
    --ui-on-c: var(--ui-neutral-fg);
    --ui-c-hover: var(--ui-c);
    @supports (color: color-mix(in lab, red, red)) {
      --ui-c-hover: color-mix(in oklab, var(--ui-c) 85%, black);
    }
    --ui-c-soft: var(--ui-neutral-soft);
    --ui-c-soft-fg: var(--ui-neutral-soft-fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--ui-font-sans);
    font-weight: 600;
    font-size: var(--ui-text-md);
    line-height: 1.25;
    padding: 0 1rem;
    border-radius: var(--ui-radius);
    border: 1px solid transparent;
    background-color: var(--ui-c);
    color: var(--ui-on-c);
    border-color: var(--ui-c);
    cursor: pointer;
    user-select: none;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
    &:hover {
      background-color: var(--ui-c);
      @supports (color: color-mix(in lab, red, red)) {
        background-color: color-mix(in oklab, var(--ui-c) 90%, black);
      }
      border-color: var(--ui-c);
      @supports (color: color-mix(in lab, red, red)) {
        border-color: color-mix(in oklab, var(--ui-c) 90%, black);
      }
    }
    &:focus-visible {
      outline: 2px solid var(--ui-c);
      outline-offset: 2px;
    }
    height: calc(var(--size-field, 0.25rem) * 10);
    &:active {
      transform: scale(0.97);
    }
  }"
`;

exports[`compiled skins > default > .ui-button base rule matches snapshot 1`] = `
