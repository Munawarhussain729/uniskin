exports[`compiled skins > shadcn > .ui-button base rule matches snapshot 1`] = `
".ui-button {
    --ui-c: var(--ui-neutral);
    --ui-on-c: var(--ui-neutral-fg);
    --ui-c-hover: var(--ui-c);
    @supports (color: color-mix(in lab, red, red)) {
      --ui-c-hover: color-mix(in oklab, var(--ui-c) 85%, black);
    }
    --ui-c-soft: var(--ui-neutral-soft);
    --ui-c-soft-fg: var(--ui-neutral-soft-fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--ui-font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.25;
    padding: 0 1rem;
    border-radius: var(--ui-radius);
    border: 1px solid transparent;
    background-color: var(--ui-c);
    color: var(--ui-on-c);
    border-color: var(--ui-c);
    cursor: pointer;
    user-select: none;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    &:hover {
      background-color: var(--ui-c-hover);
      border-color: var(--ui-c-hover);
    }
    &:focus-visible {
      outline: none;
      outline-offset: 2px;
      box-shadow: 0 0 0 1px hsl(var(--background)), 0 0 0 4px hsl(var(--ring) / 0.5);
    }
    height: 2.25rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }"
`;
