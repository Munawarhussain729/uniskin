    }
    &[aria-pressed="true"] {
      box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.2);
    }
  }
  .ui-button.ui-loading {
    cursor: progress;
    pointer-events: none;
    &::after {
      content: "";
      width: 1em;
      height: 1em;
      flex-shrink: 0;
