@layer base {
  :root {
    --ui-font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --ui-neutral: hsl(var(--primary));
    --ui-neutral-fg: hsl(var(--primary-foreground));
    --ui-neutral-soft: hsl(var(--accent));
    --ui-neutral-soft-fg: hsl(var(--accent-foreground));
    --ui-primary: hsl(var(--primary));
    --ui-primary-fg: hsl(var(--primary-foreground));
    --ui-secondary: hsl(var(--secondary));
    --ui-secondary-fg: hsl(var(--secondary-foreground));
    --ui-success: oklch(0.62 0.15 163);
    --ui-success-fg: oklch(0.98 0 0);
    --ui-warning: oklch(0.78 0.15 85);
    --ui-warning-fg: oklch(0.28 0.04 90);
    --ui-danger: hsl(var(--destructive));
    --ui-danger-fg: hsl(var(--destructive-foreground));
    --ui-surface: hsl(var(--card));
    --ui-surface-fg: hsl(var(--card-foreground));
    --ui-surface-muted: hsl(var(--muted));
    --ui-border: hsl(var(--border));
    --ui-ring: hsl(var(--ring));
    --ui-radius: var(--radius);
    --ui-text-sm: 0.8125rem;
    --ui-text-md: 0.9375rem;
    --ui-text-lg: 1.0625rem;
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --primary: 222.2 47.4% 11.2%;
    --primary-foreground: 210 40% 98%;
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222.2 47.4% 11.2%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --accent: 210 40% 96.1%;
    --accent-foreground: 222.2 47.4% 11.2%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 222.2 84% 4.9%;
    --radius: 0.5rem;
  }
  @keyframes ui-spin {
    to {
      transform: rotate(360deg);
    }
  }
}
@property --tw-border-style {
  syntax: "*";
  inherits: false;
  initial-value: solid;
}
@property --tw-outline-style {
  syntax: "*";
  inherits: false;
  initial-value: solid;
}
@layer properties {
  @supports ((-webkit-hyphens: none) and (not (margin-trim: block))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {
    *, ::before, ::after, ::backdrop {
      --tw-border-style: solid;
      --tw-outline-style: solid;
    }
  }
}
"
`;
