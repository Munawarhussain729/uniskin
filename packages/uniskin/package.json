{
  "name": "uniskin",
  "version": "0.6.0",
  "description": "One semantic class vocabulary, swappable Tailwind CSS v4 UI skins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "uniskin": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "css",
    "ui",
    "theme",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Munawarhussain729/uniskin.git",
    "directory": "packages/uniskin"
  },
  "homepage": "https://github.com/Munawarhussain729/uniskin#readme",
  "bugs": {
    "url": "https://github.com/Munawarhussain729/uniskin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
