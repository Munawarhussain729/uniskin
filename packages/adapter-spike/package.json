{
  "name": "uniskin-adapter-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: Radix Themes-like adapter for Uniskin — vocabulary stress-test, not for publishing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "uniskin": "workspace:*"
  }
}
