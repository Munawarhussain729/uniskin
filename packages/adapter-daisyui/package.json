{
  "name": "@uniskin/daisyui",
  "version": "0.0.0",
  "description": "daisyUI visual style adapter for Uniskin — uses live daisyUI theme vars when present",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "uniskin": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
